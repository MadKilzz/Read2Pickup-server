# server
APP_NAME=ReadytooPickup-backend
APP_ENV=production
APP_URL=https://your-frontend-domain.com
APP_PORT=4000

MIN_BOOKING_HOURS_AHEAD=1

# All frontend URLs are allowed for CORS (comma-separated)
APP_URLS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# jwt
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
JWT_ISSUER="readytoopickup-api"
JWT_AUDIENCE="readytoopickup-frontend"

# Stripe
STRIPE_SECRET="sk_live_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Service Area
SERVICE_AREA_LAT=52.3702
SERVICE_AREA_LNG=4.8952
SERVICE_AREA_RADIUS_KM=30

# resend (MAIL)
RESEND_API_KEY="re_REPLACE_ME"
ADMIN_EMAIL="admin@your-domain.com"

# Slack
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/REPLACE/ME"

# google
GOOGLE_PLACES_API_KEY="REPLACE_ME"

# mapbox
MAPBOX_SECRET_TOKEN="REPLACE_ME"
