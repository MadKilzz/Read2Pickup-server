{
  "name": "Ready2PickupBackend",
  "version": "1.0.0",
  "main": "src/server.ts",
  "author": "Younes",
  "license": "MIT",
  "scripts": {
    "dev": "node --watch --watch-path=src -r ts-node/register/transpile-only -r tsconfig-paths/register src/server.ts",
    "start": "ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc --build",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "test": "nodemon --verbose"
  },
  "prisma": {
    "seed": "npx ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "4.18.1",
    "express-rate-limit": "^8.2.1",
    "h3-js": "^4.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.0.0",
    "resend": "^6.9.3",
    "socket.io": "^4.8.3",
    "stripe": "^20.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "4",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@types/stripe": "^8.0.417",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
